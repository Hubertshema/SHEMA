# CallVault Production Environment Template
# Copy this file to .env and fill in production secrets.

NODE_ENV=production
PORT=3000

# Neon PostgreSQL Connection String (SSL Required)
DATABASE_URL=postgres://username:password@ep-cluster-123456.us-east-2.aws.neon.tech/callvault?sslmode=require

# JWT Secrets (Use 64+ char cryptographically random strings)
JWT_SECRET=your_super_secure_production_jwt_access_secret_here
JWT_REFRESH_SECRET=your_super_secure_production_jwt_refresh_secret_here
JWT_EXPIRES_IN=15m

# Storage Provider Configuration ('s3' or 'local')
STORAGE_PROVIDER=s3
STORAGE_BUCKET=callvault-production-storage-bucket
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
